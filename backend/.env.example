# ==============================================================
# Omniva SaaS Platform - Production Environment Configuration
# ==============================================================

# Server Port
PORT=5000

# Environment Mode (production / development)
NODE_ENV=production

# MongoDB Connection String (MongoDB Atlas or Self-Hosted)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/omniva?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/omniva_db

# Security & Authentication
# Generate a strong 64-character secret using: openssl rand -base64 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_in_production
JWT_EXPIRES_IN=7d

# Frontend URL (CORS allowed origin in production, e.g. https://yourdomain.com or *)
CLIENT_URL=https://yourdomain.com

# Meta Ads (Graph API & Conversion API) Integration
# System User Access Token from Meta Business Manager
META_ACCESS_TOKEN=your_meta_system_user_access_token_here

# Meta Webhook Verify Token (Custom secret chosen by you in Meta Developer Portal)
META_WEBHOOK_VERIFY_TOKEN=your_custom_meta_webhook_verify_token

# Razorpay Payment Gateway (Optional, for Merchant Subscriptions & Storefront Orders)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
